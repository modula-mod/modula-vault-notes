{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/modules/vault-notes/schemas/note-version-1.0.0.json",
  "title": "Vault Note Version",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "noteId", "revision", "title", "document", "createdAt", "createdBy", "changeSource"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 120},
    "noteId": {"type": "string", "minLength": 1, "maxLength": 120},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "document": {"type": "object"},
    "contentFormat": {"enum": ["blocks-v1", "markdown-v1"]},
    "canonicalBody": {"type": "string", "maxLength": 250000},
    "plainTextProjection": {"type": "string", "maxLength": 200000},
    "properties": {"type": "object"},
    "attachmentIds": {"type": "array", "items": {"type": "string", "maxLength": 180}, "maxItems": 500},
    "sensitive": {"type": "boolean"},
    "createdAt": {"type": "string", "format": "date-time"},
    "createdBy": {"type": "string", "minLength": 1, "maxLength": 120},
    "changeSource": {"enum": ["manual", "restore", "import", "ai-assisted"]}
  },
  "x-greenfield": {
    "fields": [
      {"fieldId": "noteId", "name": "noteId", "type": "recordReference", "label": "Note", "required": true},
      {"fieldId": "revision", "name": "revision", "type": "text", "label": "Revision", "required": true},
      {"fieldId": "title", "name": "title", "type": "text", "label": "Title", "required": true},
      {"fieldId": "document", "name": "document", "type": "json", "label": "Document", "required": true},
      {"fieldId": "contentFormat", "name": "contentFormat", "type": "singleSelect", "label": "Content format", "options": [{"value": "blocks-v1", "label": "Blocks"}, {"value": "markdown-v1", "label": "Markdown"}]},
      {"fieldId": "canonicalBody", "name": "canonicalBody", "type": "multilineText", "label": "Canonical body"},
      {"fieldId": "plainTextProjection", "name": "plainTextProjection", "type": "multilineText", "label": "Plain text"},
      {"fieldId": "properties", "name": "properties", "type": "json", "label": "Properties"},
      {"fieldId": "attachmentIds", "name": "attachmentIds", "type": "multiSelect", "label": "Attachments"},
      {"fieldId": "sensitive", "name": "sensitive", "type": "boolean", "label": "Sensitive"},
      {"fieldId": "changeSource", "name": "changeSource", "type": "singleSelect", "label": "Change source", "required": true, "options": [{"value": "manual", "label": "Manual"}, {"value": "restore", "label": "Restore"}, {"value": "import", "label": "Import"}, {"value": "ai-assisted", "label": "AI assisted"}]}
    ],
    "searchableFields": ["title"],
    "filterableFields": ["noteId", "changeSource"],
    "sortableFields": ["revision", "createdAt"],
    "referenceFields": ["noteId"],
    "retentionPolicy": "keepOnUninstall"
  }
}

