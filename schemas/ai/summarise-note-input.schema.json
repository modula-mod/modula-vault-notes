{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/modules/vault-notes/schemas/ai/summarise-note-input-1.0.0.json",
  "title": "Summarise Note Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordId", "expectedRevision"],
  "properties": {
    "recordId": {"type": "string", "minLength": 1, "maxLength": 120},
    "expectedRevision": {"type": "integer", "minimum": 1},
    "summaryLength": {"enum": ["short", "medium", "long"]}
  }
}
