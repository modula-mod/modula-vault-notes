{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/modules/vault-notes/schemas/ai/extract-action-items-input-1.0.0.json",
  "title": "Extract Action Items Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordId", "expectedRevision"],
  "properties": {
    "recordId": {"type": "string", "minLength": 1, "maxLength": 120},
    "expectedRevision": {"type": "integer", "minimum": 1},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockIds": {"type": "array", "maxItems": 40, "items": {"type": "string", "minLength": 1, "maxLength": 120}, "uniqueItems": true},
        "text": {"type": "string", "minLength": 1, "maxLength": 12000}
      }
    }
  }
}
