{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/modules/vault-notes/schemas/ai/extracted-action-items-result-1.0.0.json",
  "title": "Extracted Action Items Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 500},
          "dueDate": {"type": "string", "format": "date"},
          "priority": {"enum": ["low", "normal", "high"]},
          "sourceBlockId": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    }
  }
}
