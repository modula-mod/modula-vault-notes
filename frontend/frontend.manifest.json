{
  "$schema": "https://modula.digital/schemas/product-standard/1.0-rc/frontend.schema.json",
  "accessibility": {
    "declaration": "host-baseline-with-product-semantics",
    "keyboardNavigation": true,
    "reduceMotion": true,
    "scalableText": true,
    "screenReader": true
  },
  "actions": [
    {
      "family": "route.open",
      "icon": "system.plus",
      "id": "newNote",
      "label": "New note",
      "route": "/new"
    },
    {
      "family": "route.open",
      "id": "openNote",
      "label": "Open note",
      "route": "/note/:noteId"
    },
    {
      "family": "route.open",
      "id": "editNote",
      "label": "Edit note",
      "route": "/note/:noteId/edit"
    },
    {
      "family": "record.create",
      "id": "createNote",
      "inputBinding": "noteForm",
      "label": "Create note",
      "recordType": "note"
    },
    {
      "family": "record.update",
      "id": "updateNote",
      "inputBinding": "noteForm",
      "label": "Save changes",
      "recordIdBinding": "note",
      "recordType": "note"
    },
    {
      "confirm": true,
      "family": "record.delete",
      "id": "deleteNote",
      "label": "Delete note",
      "recordIdBinding": "note",
      "recordType": "note"
    },
    {
      "capability": "share.native@1",
      "family": "share",
      "id": "shareNote",
      "label": "Share"
    },
    {
      "family": "settings.update",
      "id": "saveSettings",
      "label": "Save settings",
      "settingsKey": "vaultNotes.preferences"
    }
  ],
  "capabilities": {
    "optional": [
      "share.native@1"
    ],
    "required": [
      "ui.richText@1"
    ]
  },
  "entry": "home",
  "frontendSchemaVersion": "1.0.0",
  "hostRuntime": {
    "versionRange": ">=1.0.0 <2.0.0"
  },
  "mode": "declarative",
  "mpsVersion": "1.0-RC",
  "navigation": {
    "backBehavior": "host",
    "rootView": "home",
    "secondary": [
      {
        "id": "favourites",
        "label": "Favourites",
        "viewId": "favourites"
      },
      {
        "id": "archived",
        "label": "Archived",
        "viewId": "archived"
      },
      {
        "id": "trash",
        "label": "Trash",
        "viewId": "trash"
      },
      {
        "id": "folders",
        "label": "Folders",
        "viewId": "folders"
      },
      {
        "id": "settings",
        "label": "Settings",
        "viewId": "settings"
      }
    ],
    "tabs": [
      {
        "icon": "system.note",
        "id": "notes",
        "label": "Notes",
        "viewId": "home"
      },
      {
        "icon": "system.search",
        "id": "search",
        "label": "Search",
        "viewId": "search"
      }
    ]
  },
  "platformRequirements": {
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  },
  "productId": "digital.modula.vault-notes",
  "releaseVersion": "1.4.0",
  "routes": [
    {
      "path": "/",
      "viewId": "home"
    },
    {
      "path": "/new",
      "presentation": "sheet",
      "viewId": "editor"
    },
    {
      "path": "/note/:noteId",
      "viewId": "detail"
    },
    {
      "path": "/note/:noteId/edit",
      "presentation": "sheet",
      "viewId": "editor"
    },
    {
      "path": "/search",
      "viewId": "search"
    },
    {
      "path": "/favourites",
      "viewId": "favourites"
    },
    {
      "path": "/archived",
      "viewId": "archived"
    },
    {
      "path": "/trash",
      "viewId": "trash"
    },
    {
      "path": "/folders",
      "viewId": "folders"
    },
    {
      "path": "/settings",
      "viewId": "settings"
    }
  ],
  "schema": "modula.frontend.1.0",
  "settings": {
    "viewId": "settings"
  },
  "views": [
    {
      "bindings": [
        {
          "id": "notes",
          "query": {
            "filterParam": "filter",
            "limit": 100,
            "searchParam": "q",
            "sortParam": "sort"
          },
          "recordType": "note",
          "source": "record.query"
        }
      ],
      "id": "home",
      "kind": "collection",
      "root": {
        "children": [
          {
            "children": [
              {
                "binding": "notes",
                "text": "Search your notes",
                "type": "search"
              },
              {
                "action": "newNote",
                "text": "New note",
                "type": "button"
              }
            ],
            "text": "Notes actions",
            "type": "toolbar"
          },
          {
            "accessibility": {
              "label": "Vault Notes",
              "role": "list"
            },
            "action": "openNote",
            "binding": "notes",
            "type": "recordList"
          }
        ],
        "layout": {
          "direction": "vertical",
          "gap": "regular",
          "responsive": [
            {
              "class": "compact",
              "columns": 1
            },
            {
              "class": "wide",
              "columns": 2
            }
          ]
        },
        "type": "stack"
      },
      "states": {
        "empty": {
          "children": [
            {
              "action": "newNote",
              "text": "Create your first note",
              "type": "button"
            }
          ],
          "text": "Your vault is ready for its first note",
          "type": "emptyState"
        },
        "error": {
          "accessibility": {
            "role": "status"
          },
          "text": "Vault Notes could not be loaded",
          "type": "errorState"
        },
        "loading": {
          "accessibility": {
            "role": "status"
          },
          "text": "Loading your notes",
          "type": "loadingState"
        },
        "offline": {
          "accessibility": {
            "role": "status"
          },
          "text": "Vault Notes is temporarily unavailable offline",
          "type": "errorState"
        }
      },
      "title": "Vault Notes"
    },
    {
      "bindings": [
        {
          "id": "note",
          "recordIdParam": "noteId",
          "recordType": "note",
          "source": "record.detail"
        }
      ],
      "id": "detail",
      "kind": "detail",
      "root": {
        "children": [
          {
            "children": [
              {
                "action": "editNote",
                "text": "Edit",
                "type": "button"
              },
              {
                "action": "shareNote",
                "text": "Share",
                "type": "button"
              },
              {
                "action": "deleteNote",
                "text": "Delete",
                "type": "button"
              }
            ],
            "text": "Note actions",
            "type": "toolbar"
          },
          {
            "accessibility": {
              "role": "header"
            },
            "binding": "note",
            "type": "text",
            "valuePath": "title"
          },
          {
            "binding": "note",
            "type": "text",
            "valuePath": "body"
          },
          {
            "binding": "note",
            "type": "metadata",
            "valuePath": "updatedAt"
          }
        ],
        "layout": {
          "direction": "vertical",
          "gap": "regular"
        },
        "type": "stack"
      },
      "states": {
        "error": {
          "accessibility": {
            "role": "status"
          },
          "text": "This note is unavailable",
          "type": "errorState"
        },
        "loading": {
          "accessibility": {
            "role": "status"
          },
          "text": "Loading note",
          "type": "loadingState"
        },
        "permissionDenied": {
          "accessibility": {
            "role": "status"
          },
          "text": "You do not have permission to read this note",
          "type": "errorState"
        }
      },
      "title": "Note"
    },
    {
      "bindings": [
        {
          "id": "note",
          "recordIdParam": "noteId",
          "recordType": "note",
          "source": "record.detail"
        },
        {
          "id": "noteForm",
          "source": "installation"
        }
      ],
      "id": "editor",
      "kind": "form",
      "root": {
        "accessibility": {
          "label": "Vault Notes editor",
          "role": "form"
        },
        "children": [
          {
            "binding": "noteForm",
            "field": {
              "id": "title",
              "label": "Title",
              "required": true,
              "type": "text",
              "validation": {
                "maxLength": 240
              }
            },
            "type": "field"
          },
          {
            "binding": "noteForm",
            "field": {
              "capability": "ui.richText@1",
              "id": "body",
              "label": "Body",
              "type": "richText"
            },
            "type": "field"
          },
          {
            "binding": "noteForm",
            "field": {
              "id": "folderId",
              "label": "Folder",
              "recordType": "folder",
              "type": "recordReference"
            },
            "type": "field"
          },
          {
            "binding": "noteForm",
            "field": {
              "id": "tags",
              "label": "Tags",
              "type": "tags"
            },
            "type": "field"
          },
          {
            "children": [
              {
                "action": "createNote",
                "text": "Create note",
                "type": "button"
              },
              {
                "action": "updateNote",
                "text": "Save changes",
                "type": "button"
              }
            ],
            "type": "row"
          }
        ],
        "type": "section"
      },
      "states": {
        "capabilityUnavailable": {
          "accessibility": {
            "role": "status"
          },
          "text": "This host needs the rich text editor capability",
          "type": "errorState"
        },
        "error": {
          "accessibility": {
            "role": "status"
          },
          "text": "The note could not be saved",
          "type": "errorState"
        }
      },
      "title": "Edit note"
    },
    {
      "bindings": [
        {
          "id": "notes",
          "query": {
            "filterParam": "filter",
            "limit": 100,
            "searchParam": "q",
            "sortParam": "sort"
          },
          "recordType": "note",
          "source": "record.query"
        }
      ],
      "id": "search",
      "kind": "collection",
      "root": {
        "children": [
          {
            "binding": "notes",
            "text": "Search titles, bodies, and tags",
            "type": "search"
          },
          {
            "accessibility": {
              "label": "Search results",
              "role": "list"
            },
            "action": "openNote",
            "binding": "notes",
            "type": "recordList"
          }
        ],
        "type": "stack"
      },
      "states": {
        "empty": {
          "text": "No notes match this search",
          "type": "emptyState"
        },
        "error": {
          "accessibility": {
            "role": "status"
          },
          "text": "Search is unavailable",
          "type": "errorState"
        },
        "loading": {
          "accessibility": {
            "role": "status"
          },
          "text": "Searching notes",
          "type": "loadingState"
        }
      },
      "title": "Search Vault Notes"
    },
    {
      "bindings": [
        {
          "id": "notes",
          "query": {
            "filterParam": "filter",
            "limit": 100,
            "sortParam": "sort"
          },
          "recordType": "note",
          "source": "record.query"
        }
      ],
      "id": "favourites",
      "kind": "collection",
      "root": {
        "children": [
          {
            "binding": "notes",
            "text": "Favourites",
            "type": "filter"
          },
          {
            "accessibility": {
              "label": "Favourite notes",
              "role": "list"
            },
            "action": "openNote",
            "binding": "notes",
            "type": "recordList"
          }
        ],
        "type": "stack"
      },
      "states": {
        "empty": {
          "text": "No favourite notes yet",
          "type": "emptyState"
        },
        "error": {
          "accessibility": {
            "role": "status"
          },
          "text": "Favourite notes are unavailable",
          "type": "errorState"
        }
      },
      "title": "Favourite notes"
    },
    {
      "bindings": [
        {
          "id": "notes",
          "query": {
            "filterParam": "filter",
            "limit": 100,
            "sortParam": "sort"
          },
          "recordType": "note",
          "source": "record.query"
        }
      ],
      "id": "archived",
      "kind": "collection",
      "root": {
        "children": [
          {
            "binding": "notes",
            "text": "Archived",
            "type": "filter"
          },
          {
            "accessibility": {
              "label": "Archived notes",
              "role": "list"
            },
            "action": "openNote",
            "binding": "notes",
            "type": "recordList"
          }
        ],
        "type": "stack"
      },
      "states": {
        "empty": {
          "text": "No archived notes",
          "type": "emptyState"
        },
        "error": {
          "accessibility": {
            "role": "status"
          },
          "text": "Archived notes are unavailable",
          "type": "errorState"
        }
      },
      "title": "Archived notes"
    },
    {
      "bindings": [
        {
          "id": "notes",
          "query": {
            "filterParam": "filter",
            "limit": 100,
            "sortParam": "sort"
          },
          "recordType": "note",
          "source": "record.query"
        }
      ],
      "id": "trash",
      "kind": "collection",
      "root": {
        "children": [
          {
            "binding": "notes",
            "text": "Deleted notes",
            "type": "filter"
          },
          {
            "accessibility": {
              "label": "Deleted notes",
              "role": "list"
            },
            "action": "openNote",
            "binding": "notes",
            "type": "recordList"
          }
        ],
        "type": "stack"
      },
      "states": {
        "empty": {
          "text": "Trash is empty",
          "type": "emptyState"
        },
        "error": {
          "accessibility": {
            "role": "status"
          },
          "text": "Trash is unavailable",
          "type": "errorState"
        }
      },
      "title": "Trash"
    },
    {
      "bindings": [
        {
          "id": "folders",
          "query": {
            "limit": 100,
            "searchParam": "q",
            "sortParam": "sort"
          },
          "recordType": "folder",
          "source": "record.query"
        }
      ],
      "id": "folders",
      "kind": "collection",
      "root": {
        "children": [
          {
            "binding": "folders",
            "text": "Search folders",
            "type": "search"
          },
          {
            "accessibility": {
              "label": "Vault Notes folders",
              "role": "list"
            },
            "binding": "folders",
            "type": "recordList"
          }
        ],
        "type": "stack"
      },
      "states": {
        "empty": {
          "text": "No folders yet",
          "type": "emptyState"
        },
        "error": {
          "accessibility": {
            "role": "status"
          },
          "text": "Folders are unavailable",
          "type": "errorState"
        }
      },
      "title": "Folders"
    },
    {
      "bindings": [
        {
          "id": "preferences",
          "settingsKey": "vaultNotes.preferences",
          "source": "settings"
        }
      ],
      "id": "settings",
      "kind": "settings",
      "root": {
        "accessibility": {
          "label": "Vault Notes settings",
          "role": "form"
        },
        "children": [
          {
            "binding": "preferences",
            "field": {
              "id": "archiveBeforeDelete",
              "label": "Archive before permanent deletion",
              "type": "boolean"
            },
            "type": "field"
          },
          {
            "binding": "preferences",
            "field": {
              "id": "defaultEditor",
              "label": "Default editor style",
              "options": [
                {
                  "label": "Rich text",
                  "value": "rich"
                },
                {
                  "label": "Plain text",
                  "value": "plain"
                }
              ],
              "type": "singleSelect"
            },
            "type": "field"
          },
          {
            "binding": "preferences",
            "field": {
              "id": "confirmDestructiveActions",
              "label": "Confirm destructive actions",
              "type": "boolean"
            },
            "type": "field"
          },
          {
            "action": "saveSettings",
            "text": "Save settings",
            "type": "button"
          }
        ],
        "type": "section"
      },
      "title": "Vault Notes settings"
    }
  ]
}
