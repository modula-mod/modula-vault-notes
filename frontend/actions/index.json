[
  {"id": "newNote", "family": "route.open", "label": "New note", "icon": "system.plus", "route": "/new"},
  {"id": "openNote", "family": "route.open", "label": "Open note", "route": "/note/:noteId"},
  {"id": "editNote", "family": "route.open", "label": "Edit note", "route": "/note/:noteId/edit"},
  {
    "id": "createNote",
    "family": "record.create",
    "label": "Create note",
    "recordType": "note",
    "inputBinding": "noteForm",
    "input": {
      "defaults": {"tagIds": [], "pinned": false, "favourite": false, "archived": false, "dataSchemaVersion": "1.0.0"},
      "transforms": [{"target": "plainTextProjection", "source": "document", "transform": "richText.plainText@1"}]
    }
  },
  {
    "id": "updateNote",
    "family": "record.update",
    "label": "Save changes",
    "recordType": "note",
    "recordIdBinding": "note",
    "inputBinding": "noteForm",
    "input": {
      "transforms": [{"target": "plainTextProjection", "source": "document", "transform": "richText.plainText@1"}]
    }
  },
  {"id": "deleteNote", "family": "record.delete", "label": "Delete note", "recordType": "note", "recordIdBinding": "note", "confirm": true},
  {"id": "shareNote", "family": "share", "label": "Share", "capability": "share.native@1"},
  {"id": "restoreNote", "family": "record.restore", "label": "Restore note", "recordType": "note"},
  {"id": "purgeNote", "family": "record.purge", "label": "Delete permanently", "recordType": "note", "confirm": true},
  {"id": "saveSettings", "family": "settings.update", "label": "Save settings", "settingsKey": "vaultNotes.preferences"}
]
