{
  "id": "home",
  "kind": "collection",
  "title": "Vault Notes",
  "bindings": [{"id": "notes", "source": "record.query", "recordType": "note", "query": {"searchParam": "q", "filterParam": "filter", "sortParam": "sort", "limit": 100, "filters": {"archived": false}, "recordState": "active"}}],
  "root": {
    "type": "stack",
    "layout": {"direction": "vertical", "gap": "regular", "responsive": [{"class": "compact", "columns": 1}, {"class": "wide", "columns": 2}]},
    "children": [
      {"type": "toolbar", "text": "Notes actions", "children": [{"type": "search", "text": "Search your notes", "binding": "notes"}, {"type": "button", "text": "New note", "action": "newNote"}]},
      {"type": "recordList", "binding": "notes", "action": "openNote", "accessibility": {"label": "Vault Notes", "role": "list"}}
    ]
  },
  "states": {
    "loading": {"type": "loadingState", "text": "Loading your notes", "accessibility": {"role": "status"}},
    "empty": {"type": "emptyState", "text": "Your vault is ready for its first note", "children": [{"type": "button", "text": "Create your first note", "action": "newNote"}]},
    "error": {"type": "errorState", "text": "Vault Notes could not be loaded", "accessibility": {"role": "status"}},
    "offline": {"type": "errorState", "text": "Vault Notes is temporarily unavailable offline", "accessibility": {"role": "status"}}
  }
}
