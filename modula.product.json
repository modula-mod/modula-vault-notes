    "kind": "module",
    "version": "2.0.2",
    "displayName": "Vault Notes",
    "slug": "vault-notes",
    "subtitle": "Your private knowledge space.",
    "description": "Portable private notes for Modula with folders, tags, templates, daily notes, typed properties, stable relationships, attachment metadata, history, import/export, sensitive-note policy, and governed extension points.",
    "status": "stable",
    "visibility": "public",
    "aliases": [
      "modula.vault-notes"
    ]
  },
  "publisher": {
    "id": "modula",
    "displayName": "Modula",
    "website": "https://modula.digital",
    "supportUrl": "https://modula.digital/support"
  },
