      "title": "Vault Notes composer tools",
      "contributionKinds": [
        "composer.tool"
      ],
      "maxContributions": 20
    },
    {
      "id": "digital.modula.vault-notes/settings.section@1",
      "title": "Vault Notes settings sections",
      "contributionKinds": [
        "settings.section"
      ],
      "maxContributions": 20
    }
