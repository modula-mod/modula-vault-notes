    "notes": "Vault Notes 2.0.2. Notes save into this account's module records. The home, note, and editor are the writing surfaces, and the product hub shows three screenshots.",
    "builder": "modula-product-release",
    "provenance": {
      "manifestSha256": "6645916fcb6a6dbc150928d9ee449e89e47aaf6c684f9a7dc8fe5078e7902f0e",
