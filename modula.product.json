  "privacy": {
    "dataAccessed": [
      "user-authored notes, folders, tags, properties, relationship references, attachment metadata, templates, saved searches, and saved-source references"
    ],
    "dataCreated": [
      "notes",
      "folders",
      "tags",
      "note links",
      "note versions",
      "attachment metadata",
      "templates",
      "saved searches"
    ],
    "dataTransmitted": [
      "none-by-default"
    ],
    "retention": "until uninstall deleteData or account deletion",
    "export": "Versioned JSON, Markdown, plain-text, and archive export without credentials or private signing material",
