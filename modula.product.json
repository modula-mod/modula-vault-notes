  "compatibility": {
    "productStandard": "^1.0.0",
    "greenfieldProtocol": "greenfield.v1",
    "host": ">=1.0.0",
    "moduleProfile": "^2.1.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  },
  "marketplace": {
    "category": "productivity"
  },
  "telemetry": {
    "destinationClass": "none",
    "optOut": "not-applicable",
    "purpose": "none"
  },
  "network": {
    "class": "none"
  },
  "family": {
    "id": "digital.modula.vault",
    "role": "root"
  },
  "relationships": [
    {
      "type": "belongsToFamily",
      "productId": "digital.modula.vault"
    },
    {
      "type": "compatibleWith",
      "productId": "digital.modula.vault-notes.formatting",
      "versionRange": ">=0.1.0"
    },
    {
      "type": "compatibleWith",
      "productId": "digital.modula.vault-notes.ai",
      "versionRange": ">=0.1.0"
    },
    {
      "type": "compatibleWith",
      "productId": "digital.modula.vault-notes.voice",
      "versionRange": ">=0.1.0"
    }
  ],
  "frontend": {
    "mode": "declarative",
    "artifact": {
      "path": "frontend/frontend.manifest.json",
      "mediaType": "application/vnd.modula.frontend+json",
      "sha256": "a4872caeb59818ea2fd820ff042a4fc47cc98e636fe71fb57fdf633290a5a25c",
      "schemaVersion": "1.0.0",
      "entryView": "home"
    }
  },
  "backend": {
    "mode": "greenfield-records",
    "records": [
      {
        "id": "note",
        "schemaPath": "schemas/note.schema.json",
        "schemaVersion": "1.0.0",
        "title": "Note"
      },
      {
        "id": "folder",
        "schemaPath": "schemas/folder.schema.json",
        "schemaVersion": "1.0.0",
        "title": "Folder"
      },
      {
        "id": "tag",
        "schemaPath": "schemas/tag.schema.json",
        "schemaVersion": "1.0.0",
        "title": "Tag"
      },
      {
        "id": "note-link",
        "schemaPath": "schemas/note-link.schema.json",
        "schemaVersion": "1.0.0",
        "title": "Note link"
      },
      {
        "id": "note-version",
        "schemaPath": "schemas/note-version.schema.json",
        "schemaVersion": "1.0.0",
        "title": "Note version"
      },
      {
        "id": "saved-source",
        "schemaPath": "schemas/saved-source.schema.json",
        "schemaVersion": "1.0.0",
        "title": "Saved source"
      },
      {
        "id": "attachment",
        "schemaPath": "schemas/attachment.schema.json",
        "schemaVersion": "1.0.0",
        "title": "Attachment metadata"
      },
      {
        "id": "template",
        "schemaPath": "schemas/template.schema.json",
        "schemaVersion": "1.0.0",
        "title": "Template"
      },
      {
        "id": "saved-search",
        "schemaPath": "schemas/saved-search.schema.json",
        "schemaVersion": "1.0.0",
        "title": "Saved search"
      }
    ]
  },
  "storage": {
    "mode": "greenfield-records"
  },
  "data": {
    "resources": [
      {
        "id": "notes",
        "type": "greenfield-records",
        "owner": "GREENFIELD_HOSTED_DATA",
        "schemaVersion": "1.0.0",
        "schemaPath": "schemas/note.schema.json",
        "retention": "account-lifetime",
        "backupOwner": "greenfield",
        "backupMethodClass": "platform",
        "exportOwner": "greenfield",
        "exportFormat": "application/json",
        "exportSupported": true,
        "deleteOwner": "greenfield",
        "sensitivity": "private",
        "encryption": "platform-default"
      },
      {
        "id": "folders",
        "type": "greenfield-records",
        "owner": "GREENFIELD_HOSTED_DATA",
        "schemaVersion": "1.0.0",
        "schemaPath": "schemas/folder.schema.json",
        "retention": "account-lifetime",
        "backupOwner": "greenfield",
        "backupMethodClass": "platform",
        "exportSupported": true,
        "deleteOwner": "greenfield",
        "sensitivity": "private",
        "encryption": "platform-default"
      }
    ],
    "uninstall": {
      "keepData": true,
      "deleteData": true,
      "accountDeletion": "delete"
    },
    "export": {
      "supported": true,
      "format": "application/json",
      "owner": "greenfield",
      "handler": "greenfield.export"
    }
  },
  "permissions": [
    {
      "id": "notes.read.selected",
      "reason": "Read notes you explicitly open.",
      "category": "records",
      "required": true,
      "risk": "low"
    },
    {
      "id": "notes.write",
      "reason": "Create and update your notes, folders and tags.",
      "category": "records",
      "required": true,
      "risk": "medium"
    },
    {
      "id": "notes.delete",
      "reason": "Trash, restore, or permanently delete your notes.",
      "category": "records",
      "required": true,
      "risk": "high"
    },
    {
      "id": "notes.search.publish",
      "reason": "Publish account-scoped search projections for your notes.",
      "category": "records",
      "required": true,
      "risk": "medium"
    },
    {
      "id": "notes.export",
      "reason": "Create an account-authorized export of your notes.",
      "category": "records",
      "required": true,
      "risk": "high"
    }
  ],
  "capabilities": {
    "provides": [
      "notes.provider",
      "notes.create",
      "notes.search",
      "notes.read",
      "notes.update",
      "notes.editor.contribute",
      "notes.actions.contribute",
      "notes.attachments.create",
      "notes.attachments.read",
      "notes.relationships.read",
      "notes.relationships.manage",
      "notes.properties",
      "notes.templates",
      "notes.daily",
      "notes.history",
      "notes.import",
      "notes.sensitive",
      "notes.events.subscribe"
    ],
    "requires": [],
    "requests": [],
    "providerRoles": [
      "notes.provider"
    ]
  },
