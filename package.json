{
  "name": "@modula/vault-notes",
  "version": "2.0.0",
  "description": "Portable, relationship-aware Vault Notes flagship candidate for the generic Modula module platform.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "modula.product.json",
    "modula.module.json",
    "module.manifest.json",
    "assets",
    "AGENTS.md",
    "PRODUCT.md",
    "PRIVACY.md",
    "schemas",
    "docs",
    "!docs/evidence/**",
    "frontend/frontend.manifest.json",
    "src/views",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "frontend:architecture": "node scripts/verify-frontend-architecture.mjs",
    "frontend:check": "tsc -p tsconfig.frontend.json",
    "frontend:build": "pnpm frontend:architecture && pnpm frontend:check && node scripts/build-frontend.mjs",
    "build": "pnpm frontend:build && node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:frontend": "vitest run frontend/tests",
    "test:frontend:performance": "node scripts/benchmark-frontend.mjs",
    "test:scale": "pnpm build && node scripts/benchmark-vault-notes.mjs",
    "fixtures:vault": "pnpm build && node scripts/vault-fixture-generator.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "preview:verify": "node scripts/verify-preview.mjs",
    "verify": "pnpm build && pnpm test && node scripts/verify-release.mjs",
    "release:package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@modula/module-sdk": "file:../modula-module-standard/packages/module-sdk",
    "@modula/module-standard": "file:../modula-module-standard/packages/module-standard",
    "@modula/module-validator": "file:../modula-module-standard/packages/module-validator"
  },
  "devDependencies": {
    "@modula/product-ui": "file:../modula-product-standard/packages/product-ui",
    "@types/node": "^24.0.10",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "license": "LicenseRef-Modula-First-Party"
}
